TEMPLATE = app
TARGET = jag
INCLUDEPATH += .

QT += gui core widgets opengl xml x11extras
QMAKE_CXXFLAGS += $(shell pkg-config --cflags sdl2) -g -std=gnu++14 \
-fPIE -D_FORTIFY_SOURCE=2
QMAKE_LFLAGS += $(shell pkg-config --libs sdl2 -lSDL2_mixer) \
-lGL -lX11 -lpthread -lXrandr -pie -Wl,--as-needed -Wl,-z,now

LIBS += -lGL -lX11 -lSDL2 -lSDL2_mixer -lpthread -lXrandr

OBJECTS_DIR += src
MOC_DIR += src
RCC_DIR += src
UI_DIR += src

unix: {
	target.path = /usr/games/
	INSTALLS += target
	datas.path = /usr/share/games/jag
	datas.files = data
	INSTALLS += datas
}

